# Copy this file to .env and fill in your keys. Never commit .env.

# OpenRouter (default provider) - get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-REPLACED_PLACEHOLDER

# Optional: override provider (any OpenAI-compatible endpoint)
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-your-key-here
# LLM_MODELS=gpt-4o-mini,gpt-3.5-turbo

# Optional: OpenRouter attribution headers
# OPENROUTER_REFERER=https://yoursite.com
# OPENROUTER_TITLE=Lazy Job Seeker

# Best-effort token budgeting for the interview context (approx 4 chars = 1 token).
# The assistant always sends identity + experience + the job description, and
# selectively retrieves only the most relevant project files by matching the job
# description keywords. These knobs bound per-request token usage.
# CONTEXT_MAX_TOKENS=3000        # hard total cap for the system prompt
# JD_MAX_TOKENS=800              # cap for the pasted job description/requirements
# PROJECT_MAX_TOKENS=500         # cap for each retrieved project file
# PROJECT_RETRIEVAL_COUNT=2      # how many most-relevant projects to inject per answer

# Global hotkey that fully hides/shows the window (guaranteed not captured).
# HIDE_HOTKEY=Control+Shift+H

# Auto-hide when a full-screen capture is detected. Only fires while "Protect"
# mode (the Protect toggle) is ON, and only when a screen-capture source exists.
# Best-effort on Linux (no per-window capture exclusion). Set false to disable.
# AUTO_HIDE_ON_CAPTURE=true
# AUTO_HIDE_POLL_MS=2000
